# ---------------------------------------------------------------------------
# Local development defaults. Copy this file to .env and fill in real values.
# NEVER commit the real .env.
#
# VITE_ variables are baked into the build at build time (Vite), so this one
# can't "auto-detect" like the backend's invite-link resolver does — you set
# it once per environment when you build/deploy.
# ---------------------------------------------------------------------------

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Local dev:
VITE_API_BASE_URL=http://localhost:8000/api

# Production — point this at your deployed backend's API root, then rebuild:
# VITE_API_BASE_URL=https://api.yourdomain.com/api
